# Copy to .env.local for Next.js and drizzle-kit. compose.yaml has the same defaults built in;
# to change a compose value (a port, a password), put it in a `.env` file instead.

# Vercel AI Gateway (POST /api/threads/[id]/messages)
AI_GATEWAY_API_KEY=

# Postgres from compose.yaml (pnpm stack:up). Host port 5433, see POSTGRES_PORT.
DATABASE_URL=postgres://workspace:workspace@localhost:5433/workspace

# Sign-in: Better Auth against the compose Keycloak (docker/keycloak/realms/README.md)
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/workspace
KEYCLOAK_CLIENT_ID=workspace-web
KEYCLOAK_CLIENT_SECRET=workspace-web-dev-secret

# Connections: the keys that encrypt stored credentials, `<version>:<base64>`, newest first.
# node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_KEYS=

# compose.yaml overrides (optional, for .env)
# POSTGRES_PORT=5433
# POSTGRES_USER=workspace
# POSTGRES_PASSWORD=workspace
# POSTGRES_DB=workspace
# KEYCLOAK_PORT=8080
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_DB_PASSWORD=keycloak
