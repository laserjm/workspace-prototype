{
  "name": "workspace-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && pnpm lint:styles && pnpm lint:actions",
    "lint:styles": "node scripts/check-styles.mjs",
    "lint:actions": "node scripts/check-actions.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.166",
    "@base-ui/react": "^1.9.0",
    "@conventions/nextjs": "https://github.com/laserjm/conventions/releases/download/v0.3.2/conventions-nextjs-0.3.2.tgz",
    "ai": "^7.0.162",
    "better-auth": "~1.7.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "pele": "^1.13.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
